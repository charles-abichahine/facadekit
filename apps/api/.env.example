# Copy to apps/api/.env and fill in. .env is gitignored -- never commit it.

# --- generation ---------------------------------------------------------
# cached (default, free, no key) | fal (costs money per image) | comfyui (local GPU)
FACADEKIT_GENERATE=cached
# Only read when FACADEKIT_GENERATE=fal. Create the account and paste the key
# yourself; see docs/deploy.md.
FAL_KEY=
FAL_MODEL=fal-ai/flux-lora
FAL_LORA_URL=

# Only read when FACADEKIT_GENERATE=comfyui (Charles's PC).
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW=tools/comfyui/flux_txt2img.api.json
COMFYUI_PROMPT_NODE=683
COMFYUI_SEED_NODE=678:662

# --- segmentation -------------------------------------------------------
# Path to a SAM checkpoint. Unset = fall back to pre-computed masks.
FACADEKIT_SAM_CHECKPOINT=

# --- storage ------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_DIR=./storage
# Cloudflare R2, once the bucket exists. Leave blank until then.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- pipeline defaults --------------------------------------------------
DEFAULT_CATALOGUE=demo.json
FACADE_WIDTH_MM=12000
GRID_MM=300

# --- http ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
